DATABASE_URL="mysql://root:postgres@localhost:3307/cv_generator"
JWT_SECRET="change-me-in-production"
PORT=3001
CLIENT_ORIGIN="http://localhost:5173"
NODE_ENV="development"
# Fuerza la cookie httpOnly a Secure. Por defecto: true solo cuando NODE_ENV=production.
# Ponlo en "false" si sirves el stack dockerizado por HTTP local (http://localhost:8080).
COOKIE_SECURE="false"
